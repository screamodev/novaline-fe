# Public site URL (canonical, hreflang, sitemap, OG). Keep the three in sync.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_SITE_URL=http://localhost:3000
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000
# "production" enables indexing (robots.txt / meta robots); anything else = noindex.
NUXT_SITE_ENV=development

# Server-only
NUXT_STRAPI_URL=http://localhost:1337
NUXT_STRAPI_TOKEN=
NUXT_REVALIDATE_SECRET=change-me
NUXT_OPENAI_API_KEY=sk-placeholder
NUXT_OPENAI_MODEL=gpt-4o-mini
