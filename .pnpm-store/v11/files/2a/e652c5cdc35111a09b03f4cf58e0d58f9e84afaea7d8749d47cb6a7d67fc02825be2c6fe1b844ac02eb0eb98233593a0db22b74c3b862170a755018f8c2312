{
  "name": "nuxt-schema-org",
  "type": "module",
  "version": "6.3.2",
  "description": "The quickest and easiest way to build Schema.org graphs for Nuxt.",
  "author": "Harlan Wilton <harlan@harlanzw.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/harlan-zw",
  "homepage": "https://nuxtseo.com/schema-org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlan-zw/nuxt-schema-org.git"
  },
  "bugs": {
    "url": "https://github.com/harlan-zw/nuxt-schema-org/issues"
  },
  "keywords": [
    "schema-org",
    "nuxt",
    "@nuxt-schema-org",
    "nuxt-module",
    "nuxt3"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./schema": "./dist/schema.mjs",
    "./content": "./dist/content.mjs"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "content": [
        "./dist/content.d.mts"
      ],
      "schema": [
        "./dist/schema.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@unhead/vue": "^2.0.7 || ^3.0.0",
    "unhead": "^2.0.7 || ^3.0.0",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "@unhead/vue": {
      "optional": true
    },
    "unhead": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "defu": "^6.1.7",
    "nuxt-site-config": "^4.2.3",
    "nuxtseo-shared": "^5.3.15",
    "pkg-types": "^2.3.1",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@harlan-zw/comark-content": "^0.1.4",
    "@iconify-json/lucide": "^1.2.124",
    "@nuxt/content": "^3.15.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^6.1.5",
    "@unhead/schema-org": "^3.3.2",
    "@unhead/schema-org-v2": "npm:@unhead/schema-org@^2.1.17",
    "@vue/test-utils": "^2.4.11",
    "better-sqlite3": "^13.0.3",
    "bumpp": "^12.2.1",
    "cheerio": "^1.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-harlanzw": "^0.20.0",
    "happy-dom": "^20.11.2",
    "nuxt": "^4.5.2",
    "nuxt-seo-utils": "^8.4.2",
    "nuxtseo-layer-devtools": "^5.3.14",
    "typescript": "6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  },
  "build": {
    "externals": [
      "@unhead/vue/types"
    ]
  },
  "scripts": {
    "lint": "eslint . --fix",
    "client:build": "node -e \"require('fs').cpSync('devtools','dist/devtools',{recursive:true})\"",
    "build": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt-module-build build && npm run client:build && npm run vendor:build",
    "vendor:build": "node scripts/vendor-schema-org.mjs",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && nuxt prepare client && pnpm run client:build",
    "release": "pnpm build && bumpp -x \"npx changelogen --output=CHANGELOG.md\"",
    "typecheck": "tsc --noEmit ",
    "test": "nuxt prepare test/fixtures/i18n && nuxt prepare test/fixtures/i18n-domains && vitest",
    "test:run": "pnpm test -- --run && pnpm test:nuxt5",
    "test:nuxt5": "pnpm pack --out test/fixtures/nuxt5/nuxt-schema-org.tgz && pnpm install --dir test/fixtures/nuxt5 --no-frozen-lockfile --update-checksums && pnpm --dir test/fixtures/nuxt5 test",
    "test:compat-v2": "node test/compat-v2/run.mjs",
    "test:attw": "attw --pack"
  }
}